# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=yourpassword
DB_NAME=ecommerce_auth

# Node Environment
# Values: development, production, staging, test
NODE_ENV=development

# JWT Configuration
# Generate strong random secrets (min 32 characters)
JWT_ACCESS_SECRET=your-access-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=24h

JWT_REFRESH_SECRET=your-refresh-secret-key-at-least-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d

GUEST_TOKEN_SECRET=your-guest-secret-key-at-least-32-characters-long
GUEST_TOKEN_EXPIRES_IN=30d

# Verification Configuration
# This URL is used to construct email verification links
# In production, use your actual domain (e.g., https://api.yourdomain.com)
VERIFICATION_URL_BASE=http://localhost:3000
VERIFICATION_TOKEN_EXPIRES_IN=86400

# Guest Session Configuration
# Time in seconds (default: 2592000 = 30 days)
GUEST_SESSION_EXPIRES_IN=2592000

# Bcrypt Configuration
# Cost factor for bcrypt hashing
# Recommended: 10 (for production, 12)
# Must be between 8 and 12
BCRYPT_ROUNDS=10

# Server Configuration
PORT=3000

# CORS Configuration (optional, for production)
# Comma-separated list of allowed origins
# Only used in production mode
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root123
DB_NAME=buy_or_sell

JWT_ACCESS_SECRET=your_placeholder_access_secret
JWT_REFRESH_SECRET=your_placeholder_refresh_secret
GUEST_TOKEN_SECRET=your_placeholder_guest_secret
GUEST_TOKEN_EXPIRES_IN=10d

JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d