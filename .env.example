# ==============================================================================
# E-COMMERCE AUTHENTICATION MODULE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_NAME=ecommerce_auth

# 2. Node Environment
# Supported values: development, production, staging, test
NODE_ENV=development

# 3. JWT Configuration
# Generating secrets: use strong random strings (minimum 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_chars_long
GUEST_TOKEN_SECRET=your_guest_token_secret_key_at_least_32_chars_long

# JWT Token Lifespans
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
GUEST_TOKEN_EXPIRES_IN=30d

# 4. Email Verification Configuration
# Base URL used to build verification links
VERIFICATION_URL_BASE=http://localhost:3000
# Verification link expiration time in seconds (default: 86400 = 24 hours)
VERIFICATION_TOKEN_EXPIRES_IN=86400

# 5. Guest Session Configuration
# Database guest session record expiration in seconds (default: 2592000 = 30 days)
GUEST_SESSION_EXPIRES_IN=2592000

# 6. Bcrypt Configuration
# Hashing rounds (cost factor), must be between 8 and 12 (default: 10)
BCRYPT_ROUNDS=10

# 7. Throttler / Rate Limiter Configuration
# Rate limit window in seconds (default: 60)
THROTTLER_TTL=60
# Max requests permitted inside window (default: 10)
THROTTLER_LIMIT=10

# 8. Server Configuration
PORT=3000

# 9. CORS Configuration
# Comma-separated list of allowed origins (Only checked/used in production mode)
CORS_ORIGIN=https://yourdomain.com